                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "CtlDj",
                          "name": "Ln",
                          "fill": "$--foreground",
                          "content": "  await t.wait(3000);  // 等待启动",
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "NkGWa",
                          "name": "Ln",
