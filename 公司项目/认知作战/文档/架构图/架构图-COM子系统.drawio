<mxfile host="app.diagrams.net" modified="2026-07-21T00:00:00.000Z" agent="认知行动平台文档" version="24.0.0" type="device">
  <diagram name="COM子系统架构图" id="com-arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="COM 公共功能架构图 · V3.0 / V3.10 · 2026-07-21 · 对应 SRS-COM 分册 + HLD §4.4" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;fontSize=14;fontFamily=Microsoft YaHei;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub_caption" value="职责：身份认证 + 权限与组织管理（RBAC），向所有子系统下沉共享验签库 com-auth-lib（本地 JWT 验签 + 组织行级过滤）。技术栈：Java 17 + Spring Boot 3.x。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#666666;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="1300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="com_container" value="COM 公共功能 M-COM-00（com-service · Java 17 + Spring Boot 3.x）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;fontSize=13;fontFamily=Microsoft YaHei;fontStyle=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="200" width="500" height="280" as="geometry" />
        </mxCell>
        <mxCell id="m_com_01" value="M-COM-01&#10;身份认证（身份守门人）&#10;&#10;• 登录 / 登出 / 令牌刷新&#10;• JWT 无状态令牌签发&#10;  （user_id / org_id / roles）&#10;• 多组织 / LDAP 支持可选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="260" width="210" height="180" as="geometry" />
        </mxCell>
        <mxCell id="m_com_02" value="M-COM-02&#10;权限与组织管理&#10;（权限决策与组织隔离）&#10;&#10;• 用户 / 角色 / 组织 CRUD&#10;• 账号解锁&#10;• RBAC 权限点查询&#10;• 数据范围（@DataScope）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="260" width="210" height="180" as="geometry" />
        </mxCell>
        <mxCell id="e_01_02" value="权限决策" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m_com_01" target="m_com_02">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="store_pg" value="PostgreSQL / MySQL&#10;用户 / 角色 / 组织 / 菜单&#10;DR-07（与 MC 共享审计与风险）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="520" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_02_pg" value="读写" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m_com_02" target="store_pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="auth_lib" value="com-auth-lib（共享 Java 库，下沉各子系统本地执行）&#10;&#10;• JWT 本地验签（无网络开销）&#10;• org_id 行级过滤（多组织隔离）&#10;• @PreAuthorize / @DataScope 切面&#10;• 与 com-service 密钥一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="640" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e_01_lib" value="密钥/规则同步" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;dashed=1;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#666666;" edge="1" parent="1" source="m_com_01" target="auth_lib">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe" value="前端（4 控制台 + 5 横切通用页）&#10;登录 / 系统管理控制台" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;" vertex="1" parent="1">
