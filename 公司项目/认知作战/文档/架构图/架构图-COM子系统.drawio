        </mxCell>
        <mxCell id="e_auth_all" value="本地 JWT 验签 + 组织行级过滤（无网络开销）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;fontColor=#D79B00;strokeWidth=2;" edge="1" parent="1" source="auth_lib" target="dc_node">
