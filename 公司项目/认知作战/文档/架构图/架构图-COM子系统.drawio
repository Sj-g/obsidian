          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe" value="前端（Vue3 + TS + Element Plus）&#10;4 控制台（MC/OCC/SWM/系统管理）+ 5 横切通用页&#10;localStorage 存令牌 · 跨控制台 SSO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;" vertex="1" parent="1">
