        <mxCell id="e_fe_01" value="登录 + 5 次锁定 + SSO&#10;II-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fe" target="m_com_01">
