<mxfile host="app.diagrams.net" modified="2026-07-21T00:00:00.000Z" agent="认知行动平台文档" version="24.0.0" type="device">
  <diagram name="COM子系统架构图" id="com-arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="COM 公共功能架构图 · V4.2 / V3.1（CON-16 若依化）· 2026-07-21 · 对应 SRS-COM 分册 + HLD §4.4" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;fontSize=14;fontFamily=Microsoft YaHei;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub_caption" value="职责：基于若依（RuoYi-Vue-Plus）原生框架的统一认证 + 权限与部门管理（RBAC + @DataScope）。有状态令牌（uuid+Base64 用户信息存共享 Redis），各子系统查共享 Redis 校验。废弃 JWT/com-auth-lib/org_id 多组织（V3.1/V4.2）。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#666666;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="1300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="com_container" value="COM 公共功能 M-COM-00（com-service · Java 17 + Spring Boot 3.x · 以若依 RuoYi-Vue-Plus 为底座，CON-16）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;fontSize=13;fontFamily=Microsoft YaHei;fontStyle=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="180" width="640" height="500" as="geometry" />
        </mxCell>
        <mxCell id="ruoyi_box" value="若依（RuoYi-Vue-Plus）原生框架底座（不自研鉴权组件，CON-16）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;dashed=1;fontSize=11;fontFamily=Microsoft YaHei;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="220" width="600" height="380" as="geometry" />
        </mxCell>
        <mxCell id="m_com_01" value="M-COM-01&#10;身份认证（身份守门人）&#10;&#10;基于若依原生登录：&#10;• /login + /getInfo + /getRouters&#10;• 有状态令牌：uuid + Base64 用户信息&#10;  存共享 Redis login_tokens:{uuid}&#10;  （含 user_id / dept_id / roles）&#10;• 5 次错误锁定 + 令牌黑名单 + 登出吊销" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="260" width="270" height="180" as="geometry" />
        </mxCell>
        <mxCell id="m_com_02" value="M-COM-02&#10;权限与部门管理&#10;（权限决策 + 数据权限隔离）&#10;&#10;基于若依原生 RBAC：&#10;• 功能权限 @PreAuthorize&#10;  （多角色 + role_key + 菜单/按钮权限点）&#10;• 数据权限 @DataScope + dept_id&#10;  （全部 / 本部门 / 本部门及以下 / 仅本人）&#10;• 系统管理控制台 11 页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="610" y="260" width="270" height="180" as="geometry" />
        </mxCell>
        <mxCell id="e_01_02" value="权限决策" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m_com_01" target="m_com_02">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sys_mgmt" value="系统管理控制台 11 页（若依原生 sys_user / sys_role / sys_dept / sys_menu / sys_dict 等表承载）&#10;用户 / 角色 / 部门 / 登录策略 / 登录日志 / 菜单 / 岗位 / 字典 / 参数 / 通知 / 操作日志" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="470" width="560" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e_02_sys" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;" edge="1" parent="1" source="m_com_02" target="sys_mgmt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="shared_redis" value="共享 Redis&#10;login_tokens:{uuid}&#10;（有状态令牌存储 + SSO 共享）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="970" y="200" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="store_pg" value="PostgreSQL / MySQL&#10;若依原生表（sys_user/sys_role/sys_dept&#10;sys_menu/sys_dict/sys_config 等）&#10;DR-07（与 MC 共享审计与风险）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="450" y="700" width="300" height="100" as="geometry" />
