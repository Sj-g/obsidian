        <mxCell id="title" value="IRS 私有化大模型部署架构图 · V3.0 / V3.10 · 2026-07-21 · 对应 SRS-IRS 分册 + HLD §4.6" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;fontSize=14;fontFamily=Microsoft YaHei;fontStyle=1;" vertex="1" parent="1">
